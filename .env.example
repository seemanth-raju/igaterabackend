# Application Settings
APP_NAME=igatera API
APP_ENV=production
APP_DEBUG=false
CREATE_TABLES=false

# Database (used directly when running outside Docker)
DATABASE_URL=postgresql+psycopg2://igatera:igatera_pass@localhost:5432/igatera_db

# Docker Compose – Postgres credentials (docker-compose.yml reads these)
POSTGRES_USER=igatera
POSTGRES_PASSWORD=igatera_pass
POSTGRES_DB=igatera_db

# Host port to expose the API on (default: 8000)
APP_PORT=8000

# Host port to expose Postgres on (default: 5432)
DB_PORT=5432

# JWT Settings
JWT_SECRET_KEY=change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet key for encrypting device API passwords at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=bJtuiCja4DnYwXKehteyumXVQ6qXe9lYnLD-zfuTndM=

# Background log sync interval (seconds between device polls)
LOG_SYNC_INTERVAL_SECONDS=60

# Local path for storing extracted fingerprint templates
FINGERPRINT_STORAGE_PATH=storage/fingerprints
